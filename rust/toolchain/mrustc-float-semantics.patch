-            if( ae.v != be.v )
-                return ::ord(ae.v, be.v);
+            // Constant identity is structural: +0 and -0 (and distinct NaN
+            // payloads) cannot be merged before operations such as to_bits.
+            // This IEEE total-order key also preserves finite numeric order.
+            const auto key = [](double value) {
+                uint64_t bits;
+                static_assert(sizeof(bits) == sizeof(value), "double constant representation");
+                std::memcpy(&bits, &value, sizeof(bits));
+                const uint64_t sign = uint64_t(1) << 63;
+                return (bits & sign) ? ~bits : (bits ^ sign);
+            };
+            if( key(ae.v) != key(be.v) )
+                return ::ord(key(ae.v), key(be.v));
             return ::ord((unsigned)ae.t, (unsigned)be.t);
