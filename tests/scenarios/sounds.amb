# the voice bank: SEL + ALGORITHM changes the sound of the voice on screen (pad, drone, acid; on the drums'
# pages the whole kit); each voice's Sound knob; the Kit page (SEQ three times), a sound for each drum.
# Keys on a voice's pages play it (the scale stays as it is); on any other page they edit the scale.
wait 500
expect par10 6
# the pad: SEL + ALGORITHM, then its Sound knob (KNOB 3)
tap ENV
press SEL
turn ALGO 1
release SEL
expect par10 7
expect edited 1
turn K3 1
expect par10 8
wait 1500
shot sound_pad.png
# the drone: round past the first to the last; its Sound knob is KNOB 2
tap LFO
press SEL
turn ALGO -1
release SEL
expect par84 1
turn K2 -3
expect par84 0
wait 1500
shot sound_drone.png
# the acid: its Sound is KNOB 4 on Acid env
tap ARP
tap ARP
expect view 12
turn K4 2
expect par40 5
# the kit: SEQ three times; one drum, then all four at once with SEL + ALGORITHM
tap SEQ
tap SEQ
tap SEQ
expect view 22
turn K1 1
expect par85 5
expect par86 4
press SEL
turn ALGO 2
release SEL
expect par85 7
expect par86 7
expect par87 7
expect par88 7
wait 1500
shot kit.png
# a page with no voice: nothing changes
tap HOME
press SEL
turn ALGO 1
release SEL
expect par10 8
expect par84 0
# keys on a voice's page still edit the scale while it plays with the music, as everywhere
tap LFO
tapkey w3
wait 50
expect held 0
expect pool <2738
tapkey w3
wait 50
expect pool 2741
# SEL + ENV on the drone's page: the drone off the algorithm (silent but for the keys); now its keys play it,
# the scale untouched
press SEL
tap ENV
release SEL
expect par90 1
expect par89 0
expect view 6
wait 1500
expect bass_level <5
key w2 down
wait 300
expect held 1
expect pool 2741
expect bass_level >50
shot playing_drone.png
key w2 up
wait 100
expect held 0
# back on the algorithm: SEL + ENV again; the keys are the scale's again
press SEL
tap ENV
release SEL
expect par90 0
wait 2500
expect bass_level >50
# the pad by hand (from its envelope page: any of its pages will do): two keys, two of its voices
tap ENV
tap ENV
press SEL
tap ENV
release SEL
expect par89 1
expect view 2
key w0 down
key w4 down
wait 400
expect held 2
key w0 up
key w4 up
wait 100
expect held 0
expect pool 2741
press SEL
tap ENV
release SEL
expect par89 0
# not on a voice's page: SEL + ENV changes nothing
tap HOME
press SEL
tap ENV
release SEL
expect par89 0
expect par90 0
expect par91 0
expect view 0
# the acid by hand, played while stopped: it sounds
tap ARP
press SEL
tap ENV
release SEL
expect par91 1
tap PLAY
wait 600
expect playing 0
peakreset
key w7 down
wait 400
expect held 1
expect peak_db_max -0.5
expect peak_db_min -40
key w7 up
# a key let go after the page changed still lets go of its note
key w9 down
wait 100
tap HOME
key w9 up
wait 100
expect held 0
# on Tempo the keys edit the scale, as ever
tapkey w1
wait 50
expect held 0
expect pool 3765
# back on the algorithm while a key is held: the note let go
tap ARP
key w9 down
wait 50
expect held 1
press SEL
tap ENV
release SEL
expect par91 0
wait 50
expect held 0
key w9 up
