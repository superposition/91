# Production song selection and independent detail controls.
jamboot
wait 250
expect view 38
expect jam_version 2
expect jam_song 0
expect jam_form 0
tap PLAY
wait 100
expect playing 0
spin PRESET 1
wait 400
expect jam_song 1
expect jam_version 2
spin SELECT 1
wait 50
expect view 39
shot arrangement.png
spin SELECT 1
wait 50
expect view 40
spin K2 -1
wait 50
