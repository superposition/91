# Production startup, separate from the legacy scenarios' explicit old defaults.
jamboot
wait 150
expect view 38
expect jam_on 1
expect jam_length 16
expect jam_key 0
press GLO
spin PRESET 1
release GLO
spin K1 1
spin K3 -1
wait 100
expect jam_pending 1
expect jam_length 16
expect jam_key 1
wait 39000
expect jam_length 8
expect jam_pending 0
expect jam_form 1
tapkey w0
wait 100
expect jam_hold 1
tapkey w1
wait 100
expect jam_hold 0
expect jam_pending 1
tap PLAY
wait 100
tap SAVE
wait 100
reboot
wait 150
expect view 38
expect jam_length 8
expect jam_key 1
expect jam_form 1
shot jam_helper.png
tapkey w7
wait 100
expect jam_on 0
expect view 36
