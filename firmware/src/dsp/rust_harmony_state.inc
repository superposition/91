/* Generated copies only; engine/render/drain inputs initialized; no source-state borrow retained. */
static void harmony_read(fm1_harm_state_t *s,fm1_harm_config_t *c)
{
    memset(s,0,sizeof *s);
    memcpy(s->steps,steps,sizeof s->steps);
    memcpy(s->steps_nat,steps_nat,sizeof s->steps_nat);
    s->nsteps=nsteps;
    s->deg=deg;
    s->hr_left=hr_left;
    s->chord_nt=chord_nt;
    s->pool=pool;
    s->dom_on=dom_on;
    s->walk_bor=walk_bor;
    s->deg_prev=deg_prev;
    s->cad_n=cad_n;
    s->dh_n=dh_n;
    s->dh_i=dh_i;
    s->dh_ln=dh_ln;
    s->pg_len=pg_len;
    s->pg_i=pg_i;
    s->pg_on=pg_on;
    s->drift_unit=drift_unit;
    s->pg_start=pg_start;
    s->hist_n=hist_n;
    s->change_pending=change_pending;
    s->fifth_done=fifth_done;
    s->drop_tonic=drop_tonic;
    s->naiwan_arc=naiwan_arc;
    s->naiwan_left=naiwan_left;
    s->naiwan_rotate=naiwan_rotate;
    s->en_chord_alt=en_chord_alt;
    s->en_walk_next_root=en_walk_next_root;
    s->walk_next=walk_next;
    s->naiwan_pending=naiwan_pending;
    s->en_walk_next=en_walk_next;
    s->en_prog_pos=en_prog_pos;
    memcpy(s->dh,dh,sizeof s->dh);
    memcpy(s->pg_kind,pg_kind,sizeof s->pg_kind);
    memcpy(s->pg_deg,pg_deg,sizeof s->pg_deg);
    memcpy(s->pg_bars,pg_bars,sizeof s->pg_bars);
    memcpy(s->hist,hist,sizeof s->hist);
    memcpy(s->chord_pcs,chord_pcs,sizeof s->chord_pcs);
    s->drift_left=drift_left;
    s->drift_total=drift_total;
    c->genre=chord_genre;
    c->root=par[P_ROOT];
    c->chord_kind=par[P_CHORD];
    c->loop_mode=par[P_CH_LOOP];
    c->drift=par[P_DRIFT];
    c->pad_oct=par[P_PAD_OCT];
    c->song_oct=par[P_OCT];
    c->voicing=par[P_VOICING];
    c->trigger=par[P_DE_TRIG];
    c->pedal=pedal;
    c->playing=en_playing;
    c->step_length=step_len;
}
static void harmony_write(const fm1_harm_state_t *s)
{
    memcpy(steps,s->steps,sizeof s->steps);
    memcpy(steps_nat,s->steps_nat,sizeof s->steps_nat);
    nsteps=s->nsteps;
    deg=s->deg;
    hr_left=s->hr_left;
    chord_nt=s->chord_nt;
    pool=s->pool;
    dom_on=s->dom_on;
    walk_bor=s->walk_bor;
    deg_prev=s->deg_prev;
    cad_n=s->cad_n;
    dh_n=s->dh_n;
    dh_i=s->dh_i;
    dh_ln=s->dh_ln;
    pg_len=s->pg_len;
    pg_i=s->pg_i;
    pg_on=s->pg_on;
    drift_unit=s->drift_unit;
    pg_start=s->pg_start;
    hist_n=s->hist_n;
    change_pending=s->change_pending;
    fifth_done=s->fifth_done;
    drop_tonic=s->drop_tonic;
    naiwan_arc=s->naiwan_arc;
    naiwan_left=s->naiwan_left;
    naiwan_rotate=s->naiwan_rotate;
    en_chord_alt=s->en_chord_alt;
    en_walk_next_root=s->en_walk_next_root;
    walk_next=s->walk_next;
    naiwan_pending=s->naiwan_pending;
    en_walk_next=s->en_walk_next;
    en_prog_pos=s->en_prog_pos;
    memcpy(dh,s->dh,sizeof s->dh);
    memcpy(pg_kind,s->pg_kind,sizeof s->pg_kind);
    memcpy(pg_deg,s->pg_deg,sizeof s->pg_deg);
    memcpy(pg_bars,s->pg_bars,sizeof s->pg_bars);
    memcpy(hist,s->hist,sizeof s->hist);
    memcpy(chord_pcs,s->chord_pcs,sizeof s->chord_pcs);
    drift_left=s->drift_left;
    drift_total=s->drift_total;
}
